flowchart TD
    A[Start] --> B[Initialize hasUpperCase=false and hasDigit=false]
    B --> C[Loop through password characters]
    C --> D{Uppercase char?}
    D -- Yes --> E[Set hasUpperCase=true]
    D -- No --> F[Continue]
    E --> F
    F --> G{Digit char?}
    G -- Yes --> H[Set hasDigit=true]
    G -- No --> I[Continue]
    H --> I
    I --> J{Both true?}
    J -- Yes --> K[Return true]
    J -- No --> L{More chars?}
    L -- Yes --> C
    L -- No --> M[Return false]
    K --> N[End]
    M --> N
