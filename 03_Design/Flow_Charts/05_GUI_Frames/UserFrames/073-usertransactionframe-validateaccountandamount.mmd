flowchart TD
    A[Start] --> B[Create ValidationService]
    B --> C{Account number valid?}
    C -- No --> D[Show invalid account]
    C -- Yes --> E{Account exists?}
    E -- No --> F[Show missing account]
    E -- Yes --> G{Amount valid?}
    G -- No --> H[Show invalid amount]
    G -- Yes --> I[Return true]
    D --> J[Return false]
    F --> J
    H --> J
    I --> K[End]
    J --> K
