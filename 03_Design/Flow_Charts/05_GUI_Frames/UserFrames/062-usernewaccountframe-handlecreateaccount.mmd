flowchart TD
    A[Start] --> B[Read selected account type]
    B --> C[Print selected type]
    C --> D[Create ValidationService]
    D --> E{Selected type valid?}
    E -- No --> F[Show choose account type error]
    E -- Yes --> G{Account limit allows more accounts?}
    G -- No --> H[Show account limit reached]
    G -- Yes --> I[Create Client model]
    I --> J[Call Client.createAccount]
    J --> K{Account returned?}
    K -- No --> L[Show account creation failed]
    K -- Yes --> M[Show success with type and account number]
    F --> N[End]
    H --> N
    L --> N
    M --> N
