flowchart TD
    A[Start] --> B[Read to, from, and amount]
    B --> C{Any field empty?}
    C -- Yes --> D[Show error]
    C -- No --> E{From equals to?}
    E -- Yes --> F[Show same-account error]
    E -- No --> G[Parse amount]
    G --> H{Amount parse failed?}
    H -- Yes --> I[Stop]
    H -- No --> J[Create ValidationService]
    J --> K{From account valid?}
    K -- No --> L[Show invalid from account]
    K -- Yes --> M{To account valid?}
    M -- No --> N[Show invalid to account]
    M -- Yes --> O{From exists?}
    O -- No --> P[Show missing from account]
    O -- Yes --> Q{To exists?}
    Q -- No --> R[Show missing to account]
    Q -- Yes --> S{Amount valid?}
    S -- No --> T[Show invalid amount]
    S -- Yes --> U[Call Client.fundTransfer]
    U --> V{Transferred?}
    V -- Yes --> W[Show success]
    V -- No --> X[Show failure]
    D --> Y[End]
    F --> Y
    I --> Y
    L --> Y
    N --> Y
    P --> Y
    R --> Y
    T --> Y
    W --> Y
    X --> Y
