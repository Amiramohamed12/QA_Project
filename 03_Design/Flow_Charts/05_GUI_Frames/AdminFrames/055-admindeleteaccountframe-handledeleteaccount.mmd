flowchart TD
    A[Start] --> B[Read account number]
    B --> C{Empty?}
    C -- Yes --> D[Show missing account error]
    C -- No --> E[Create ValidationService]
    E --> F{Format valid?}
    F -- No --> G[Show invalid account error]
    F -- Yes --> H{Account exists?}
    H -- No --> I[Show account missing error]
    H -- Yes --> J[Call Admin.deleteClientAccount]
    J --> K{Deleted?}
    K -- Yes --> L[Show success]
    K -- No --> M[Show failure]
    D --> N[End]
    G --> N
    I --> N
    L --> N
    M --> N
