flowchart TD
    A[Start] --> B[Read to, from, and amount fields]
    B --> C{Any field empty?}
    C -- Yes --> D[Show fill all fields error]
    C -- No --> E{From equals to?}
    E -- Yes --> F[Show same-account error]
    E -- No --> G[Create ValidationService]
    G --> H{From account valid?}
    H -- No --> I[Show invalid from account]
    H -- Yes --> J{To account valid?}
    J -- No --> K[Show invalid to account]
    J -- Yes --> L{From exists?}
    L -- No --> M[Show missing from account]
    L -- Yes --> N{To exists?}
    N -- No --> O[Show missing to account]
    N -- Yes --> P{Amount parses?}
    P -- No --> Q[Show invalid amount]
    P -- Yes --> R{Amount valid?}
    R -- No --> Q
    R -- Yes --> S[Call Admin.fundTransfer]
    S --> T{Transferred?}
    T -- Yes --> U[Show success]
    T -- No --> V[Show failure]
    D --> W[End]
    F --> W
    I --> W
    K --> W
    M --> W
    O --> W
    Q --> W
    U --> W
    V --> W
