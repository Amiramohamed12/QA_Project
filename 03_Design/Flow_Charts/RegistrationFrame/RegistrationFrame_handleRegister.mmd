flowchart TD
    v1_start(["Start RegistrationFrame.handleRegister"])
    v1_end(["End RegistrationFrame.handleRegister"])
    v1_a["Read form values or current session"]
    v1_d{"Do the main rules pass?<br/>(names are letters-only and the right length; email format is valid; password format and length are valid; SSN contains digits only)"}
    v1_bad["Show the matching error message and stop"]
    v1_act["Create the client record, then send the user back to login"]
    v1_done["Show success, failure, or loaded data based on the result"]
    v1_start --> v1_a
    v1_a --> v1_d
    v1_d -->|"No"| v1_bad
    v1_bad --> v1_end
    v1_d -->|"Yes"| v1_act
    v1_act --> v1_done
    v1_done --> v1_end
