flowchart TD
    v1_start(["Start AdminCreateAccountFrame.handleCreateAccount"])
    v1_end(["End AdminCreateAccountFrame.handleCreateAccount"])
    v1_a["Read form values or current session"]
    v1_d{"Do the main rules pass?<br/>(user ID is present, 5 digits, and exists when needed; account number is valid and found when needed; customer is under the 3-account limit)"}
    v1_bad["Show the matching error message and stop"]
    v1_act["Ask the admin model to create the selected account for the user"]
    v1_done["Show success, failure, or loaded data based on the result"]
    v1_start --> v1_a
    v1_a --> v1_d
    v1_d -->|"No"| v1_bad
    v1_bad --> v1_end
    v1_d -->|"Yes"| v1_act
    v1_act --> v1_done
    v1_done --> v1_end
